<Window x:Class="CtrlCpp.Views.HistoryPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录"
        Width="420"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="#181818"
        BorderThickness="1"
        BorderBrush="#303030"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Left="-32000" Top="-32000">

    <Window.Resources>
        <!-- 卡片式列表项（设计稿：400×110 圆角10 #6D6D6D 间距6） -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0,10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#6D6D6D" CornerRadius="10"
                                BorderThickness="1.5" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#787878"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7E7E7E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EDF4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate">
            <Border Height="110" Padding="15,16" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 图标方块 78×78 圆角10 #181818 -->
                    <Border Width="78" Height="78" CornerRadius="10" Background="#181818"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Grid>
                            <!-- 设计稿矢量文档图标（文字/链接） -->
                            <Path Data="M19,34 C19,25.716 25.716,19 34,19 H57 C58.105,19 59,19.895 59,21 V44 C59,52.284 52.284,59 44,59 H22 C20.343,59 19,57.657 19,56 V34 Z"
                                  Fill="#D9D9D9"
                                  Visibility="{Binding DocIconVisibility}"/>
                            <Path Data="M30,28 H49 M30,31 H49 M30,34 H49 M30,37 H49 M30,40 H49 M30,43 H49 M30,46 H49 M30,49 H49 M30,52 H49"
                                  Stroke="#699BF7" StrokeThickness="1"
                                  Visibility="{Binding DocIconVisibility}"/>
                            <!-- 图片/文件暂用系统图标 -->
                            <TextBlock Text="{Binding KindGlyph}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="#FFFFFF"
                                       Visibility="{Binding GlyphVisibility}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding FileIcon}" Stretch="Uniform" Margin="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="17,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="14" Foreground="#EDF4FA"
                                   TextWrapping="Wrap" MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Caption}"
                                   FontSize="11" Foreground="#DADADA" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 浅色搜索框（设计稿：400×40 圆角10 #D9D9D9） -->
        <Border Margin="10,13,10,11" Background="#D9D9D9" CornerRadius="10" Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 黑色描边放大镜（设计稿矢量） -->
                <Path Data="M21.5,7 C27.89,7 33,11.96 33,18 C33,24.03 27.89,29 21.5,29 C15.11,29 10,24.03 10,18 C10,11.96 15.11,7 21.5,7 Z M30,27 L39,35"
                      Stroke="#1A1A1A" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" Width="40" Height="40"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#1A1A1A" CaretBrush="#FF8577"
                         VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13.5"
                         TextChanged="OnSearchChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                           Text="搜索文本或链接" Foreground="#6D6D6D"
                           VerticalAlignment="Center" Margin="9,0,0,0" FontSize="13.5"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="ClearBtn" Grid.Column="2" Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#595959" VerticalAlignment="Center"
                           Margin="0,0,14,0" Visibility="Collapsed"
                           Cursor="Hand" MouseLeftButtonUp="OnClearSearch"/>
            </Grid>
        </Border>

        <ListBox x:Name="List" Grid.Row="1"
                 MaxHeight="550"
                 ItemTemplate="{StaticResource ItemTemplate}"
                 Background="Transparent" BorderThickness="0" Padding="0,0,0,2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 PreviewMouseLeftButtonUp="OnListClick"
                 ContextMenuOpening="OnMenuOpening"/>

        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                       Foreground="#3A3A3A" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Text="暂无剪贴板记录" Foreground="#8C8C8C"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"
                       TextAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#2E2E2E"
                Padding="12,7">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8C8C8C"
                       Text="共 0 条 · Enter 粘贴 · Del 删除 · Esc 关闭"/>
        </Border>
    </Grid>
</Window>
