<Window x:Class="CtrlCpp.Views.ExcludedAppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加要排除的应用"
        Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择正在运行的应用，或手动输入程序名（如 wechat.exe）"
                   Foreground="#9B9B9B" FontSize="12" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#161616" BorderBrush="#2A2A2A"
                BorderThickness="1" CornerRadius="6" Height="34" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="#7A7A7A" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#F2F2F2" CaretBrush="#F2F2F2"
                         VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                         TextChanged="OnSearchChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                           Text="搜索程序" Foreground="#5A5A5A"
                           VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <ListBox x:Name="ProcList" Grid.Row="2"
                 Background="Transparent" BorderThickness="0"
                 Foreground="#F2F2F2" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnProcDoubleClick"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#161616" BorderBrush="#2A2A2A"
                    BorderThickness="1" CornerRadius="6" Height="34" Margin="0,0,10,0">
                <TextBox x:Name="ManualBox" Background="Transparent" BorderThickness="0"
                         Foreground="#F2F2F2" CaretBrush="#F2F2F2"
                         VerticalAlignment="Center" Margin="10,0,10,0" FontSize="12"/>
            </Border>
            <Button x:Name="AddManualBtn" Grid.Column="1" Content="手动添加"
                    Click="OnAddManual" Padding="12,6" Background="#262626"
                    Foreground="#F2F2F2" BorderBrush="#3A3A3A"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"
                    Background="#1C1C1C" Foreground="#F2F2F2" BorderBrush="#3A3A3A"/>
            <Button Content="添加" Click="OnAddSelected" Padding="14,6"
                    Background="#4CC2FF" Foreground="#0D0D0D" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
