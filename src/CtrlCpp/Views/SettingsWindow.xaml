<ui:FluentWindow x:Class="CtrlCpp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CtrlC++ 设置"
        Width="560" Height="660"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="#1E1E1E"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="设置" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,6,26,20">
            <StackPanel>
                <TextBlock Text="常规" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" Margin="0,10,0,10"/>

                <TextBlock Text="打开历史窗口的快捷键" Foreground="#F2F2F2" FontSize="13"/>
                <TextBlock Text="点击下方输入框，然后按下想要的组合键（例如 Ctrl+B）；单独的 F1~F12 也可以；按 Esc 取消"
                           Foreground="#7A7A7A" FontSize="11" Margin="0,2,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#161616" BorderBrush="#2A2A2A"
                            BorderThickness="1" CornerRadius="6" Height="34">
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#F2F2F2" CaretBrush="#F2F2F2"
                                 VerticalAlignment="Center" Margin="10,0" FontSize="12"
                                 AutomationProperties.Name="HotkeyBox"
                                 GotFocus="OnHotkeyGotFocus" LostFocus="OnHotkeyLostFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown"/>
                    </Border>
                    <ui:Button Grid.Column="1" Content="恢复默认" Appearance="Secondary"
                               Margin="8,0,0,0" Click="OnHotkeyReset"
                               AutomationProperties.Name="HotkeyResetButton"/>
                </Grid>
                <TextBlock x:Name="HotkeyHint" Foreground="#FF7A7A" FontSize="11"
                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自动运行" Foreground="#F2F2F2" FontSize="13"/>
                        <TextBlock Text="随 Windows 启动后在后台运行"
                                   Foreground="#7A7A7A" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                </Grid>

                <TextBlock Text="记录" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" Margin="0,24,0,10"/>
                <TextBlock Text="保留天数（超过则自动删除）" Foreground="#9B9B9B" FontSize="12"/>
                <ui:NumberBox x:Name="RetentionBox" Width="160" HorizontalAlignment="Left"
                              Margin="0,6,0,14" LostFocus="OnNumberCommitted"/>
                <TextBlock Text="缓存上限（MB，超过后从最旧的记录开始清理）" Foreground="#9B9B9B" FontSize="12"/>
                <ui:NumberBox x:Name="CacheLimitBox" Width="160" HorizontalAlignment="Left"
                              Margin="0,6,0,14" LostFocus="OnNumberCommitted"/>
                <TextBlock x:Name="UsageText" Foreground="#9B9B9B" FontSize="12"/>
                <ProgressBar x:Name="UsageBar" Height="6" Maximum="1" Minimum="0"
                             Margin="0,8,0,0" Background="#161616"
                             Foreground="#4CC2FF" BorderThickness="0"/>

                <TextBlock Text="排除应用" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" Margin="0,24,0,2"/>
                <TextBlock Text="不记录以下应用的复制内容" Foreground="#7A7A7A" FontSize="11"/>
                <ItemsControl x:Name="ExcludedList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161616" CornerRadius="6" Padding="10,7"
                                    Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" Foreground="#F2F2F2"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="移除" Click="OnRemoveExcluded"
                                            FontSize="11" Margin="10,0,0,0" Padding="8,3"
                                            Background="#262626" Foreground="#F2F2F2"
                                            BorderBrush="#3A3A3A"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="添加应用…" Appearance="Secondary" Click="OnAddExcluded"
                           HorizontalAlignment="Left" Margin="0,10,0,0"/>

                <TextBlock Text="危险操作" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" Margin="0,26,0,10"/>
                <ui:Button Content="立即清空全部历史" Appearance="Danger" Click="OnClearAll"
                           HorizontalAlignment="Left"/>

                <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" Margin="0,26,0,10"/>
                <TextBlock Foreground="#9B9B9B" FontSize="12" LineHeight="21">
                    快捷键：默认 Ctrl + 空格 打开/关闭历史窗口，可在"常规"中自定义。<LineBreak/>
                    单击或回车：自动粘贴到刚才使用的程序；Esc 关闭窗口。<LineBreak/>
                    提示：若快捷键与其他软件/输入法的组合键相同，本程序会优先占用。<LineBreak/>
                    已知限制：在管理员权限的程序窗口中，快捷键不会触发。<LineBreak/>
                    <Run x:Name="VersionRun"/>
                </TextBlock>

                <ui:Button Content="关闭" Appearance="Primary" Click="OnClose"
                           HorizontalAlignment="Right" Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
